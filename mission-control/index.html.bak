<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=1920, initial-scale=1.0">
<title>Mission Control TV</title>
<meta name="theme-color" content="#05070d">
<style>
  :root{
    --bg:#05070d;
    --txt:#eef3fa; --dim:#a7b3c7; --faint:#6b7690;
    --acc1:#6ee7ff; --acc2:#a78bfa; --acc3:#f472b6;
    --ok:#34d399; --warn:#fbbf24; --bad:#f87171;
    --focus:#6ee7ff;
  }
  *{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
  html,body{height:100%;}
  body{
    margin:0; color:var(--txt);
    font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI",Roboto,Inter,sans-serif;
    background:
      radial-gradient(1400px 700px at 15% -5%, rgba(110,231,255,.08), transparent 60%),
      radial-gradient(1200px 800px at 90% 10%, rgba(167,139,250,.09), transparent 60%),
      radial-gradient(1000px 1000px at 50% 115%, rgba(244,114,182,.06), transparent 60%),
      var(--bg);
    background-attachment:fixed;
    padding:36px 56px 30px;
    min-height:100vh;
    overflow:hidden;
    font-size:26px;
  }
  .orb{position:fixed; border-radius:50%; filter:blur(110px); opacity:.15; pointer-events:none; z-index:0;
       animation:drift 26s ease-in-out infinite alternate;}
  .orb.o1{width:420px;height:420px;left:-110px;top:6%;background:#2563eb;}
  .orb.o2{width:380px;height:380px;right:-100px;top:36%;background:#7c3aed;animation-delay:-9s;}
  .orb.o3{width:320px;height:320px;left:32%;bottom:-110px;background:#db2777;animation-delay:-17s;opacity:.10;}
  @keyframes drift{from{transform:translate(0,0) scale(1);}to{transform:translate(50px,70px) scale(1.12);}}

  .wrap{position:relative; z-index:1; height:calc(100vh - 66px); display:flex; flex-direction:column;}

  /* ---------- header ---------- */
  header{display:flex; align-items:center; justify-content:space-between; gap:20px; padding:6px 8px 18px;}
  .brand{display:flex; align-items:center; gap:22px;}
  .logo{width:84px; height:84px; border-radius:24px; display:grid; place-items:center; flex:none;
        background:conic-gradient(from 200deg,#0ea5e9,#8b5cf6,#ec4899,#0ea5e9);
        box-shadow:0 0 34px rgba(139,92,246,.5), inset 0 0 0 3px rgba(255,255,255,.25);
        animation:spinGlow 9s linear infinite;}
  @keyframes spinGlow{to{filter:hue-rotate(360deg);}}
  .logo svg{width:48px;height:48px;}
  .brand h1{margin:0; font-size:52px; letter-spacing:5px; font-weight:800;
    background:linear-gradient(92deg,#fff 10%,var(--acc1) 45%,var(--acc2) 75%,var(--acc3));
    -webkit-background-clip:text; background-clip:text; color:transparent;}
  .brand .tag{margin:4px 0 0; font-size:22px; color:var(--dim); letter-spacing:.5px;}
  .hdr-right{text-align:right;}
  #clock{font-size:64px; font-weight:700; font-variant-numeric:tabular-nums; letter-spacing:2px; line-height:1;
         background:linear-gradient(180deg,#fff,#9db4d0); -webkit-background-clip:text; background-clip:text; color:transparent;}
  #updated{font-size:20px; color:var(--dim); margin-top:6px;}
  #updated .fresh{color:var(--ok);}

  /* ---------- sections / rows ---------- */
  #rows{flex:1; overflow:hidden; display:flex; flex-direction:column; justify-content:center; gap:6px;}
  .seclabel{display:flex; align-items:center; gap:18px; margin:10px 8px 12px;}
  .seclabel span{font-size:24px; font-weight:800; letter-spacing:5px; color:var(--faint); text-transform:uppercase; white-space:nowrap;}
  .seclabel::after{content:""; flex:1; height:2px;
    background:linear-gradient(90deg, rgba(255,255,255,.16), transparent);}
  .row{display:flex; gap:22px; overflow-x:auto; padding:10px 8px 18px; scroll-behavior:smooth;
       scrollbar-width:none;}
  .row::-webkit-scrollbar{display:none;}

  /* ---------- cards ---------- */
  .card{
    position:relative; overflow:hidden; flex:0 0 460px;
    background:linear-gradient(165deg, rgba(255,255,255,.065), rgba(255,255,255,.018) 55%, rgba(255,255,255,.04));
    border:3px solid rgba(255,255,255,.09);
    border-radius:26px;
    padding:28px 28px 24px;
    box-shadow:0 14px 38px rgba(0,0,0,.42);
    transition:transform .18s ease, border-color .18s ease, box-shadow .18s ease;
    outline:none;
  }
  .card::before{content:""; position:absolute; inset:0 0 auto 0; height:6px;
    background:var(--stripe, linear-gradient(90deg,var(--acc1),var(--acc2)));}
  .card.k-server{--stripe:linear-gradient(90deg,#38bdf8,#6366f1);}
  .card.k-phone{--stripe:linear-gradient(90deg,#a78bfa,#f472b6);}
  .card.k-tv{--stripe:linear-gradient(90deg,#fbbf24,#f97316);}
  .card.k-gh{--stripe:linear-gradient(90deg,#e6edf3,#8b949e);}
  .card.k-am{--stripe:linear-gradient(90deg,#fa2d48,#fc5c72);}
  .card.k-artist{--stripe:linear-gradient(90deg,#fb7185,#c026d3);}
  .card.k-emby{--stripe:linear-gradient(90deg,#38bdf8,#818cf8);}
  .card.k-tb{--stripe:linear-gradient(90deg,#5eead4,#38bdf8);}
  .card.k-bt{--stripe:linear-gradient(90deg,#f0abfc,#a78bfa);}
  .card.k-kg{--stripe:linear-gradient(90deg,#86efac,#34d399);}
  .card.k-act{--stripe:linear-gradient(90deg,#fca5a5,#f97316);}
  .card.k-cal{--stripe:linear-gradient(90deg,#fcd34d,#fbbf24);}

  /* DPAD focus */
  .card.focused{
    border-color:var(--focus);
    transform:scale(1.045);
    box-shadow:0 0 0 4px rgba(110,231,255,.35), 0 20px 55px rgba(0,0,0,.6), 0 0 44px rgba(110,231,255,.22);
    z-index:2;
  }
  .qbtn.focused{
    border-color:var(--focus);
    box-shadow:0 0 0 4px rgba(110,231,255,.35), 0 0 30px rgba(110,231,255,.25);
    transform:scale(1.03);
  }

  .chead{display:flex; align-items:center; gap:18px; margin-bottom:8px;}
  .icon-tile{width:76px; height:76px; border-radius:22px; display:grid; place-items:center; flex:none;
    background:linear-gradient(140deg, rgba(110,231,255,.20), rgba(167,139,250,.20));
    border:2px solid rgba(255,255,255,.14);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.12), 0 6px 20px rgba(0,0,0,.35);}
  .icon-tile svg{width:44px; height:44px;}
  .chead h2{margin:0; font-size:34px; font-weight:700; letter-spacing:.3px; line-height:1.15;}
  .chead .sub{font-size:20px; color:var(--dim); margin-top:4px; font-variant-numeric:tabular-nums;}
  .chead .spacer{flex:1;}

  .dotlive{width:20px; height:20px; border-radius:50%; display:inline-block; flex:none;}
  .dotlive.on{background:var(--ok); box-shadow:0 0 16px var(--ok); animation:pulse 2.2s ease-in-out infinite;}
  .dotlive.off{background:var(--bad); box-shadow:0 0 12px rgba(248,113,113,.7);}
  .dotlive.na{background:var(--warn); box-shadow:0 0 12px rgba(251,191,36,.7); animation:pulse 3s ease-in-out infinite;}
  @keyframes pulse{0%,100%{transform:scale(1); opacity:1;}50%{transform:scale(.72); opacity:.65;}}

  .pill{display:inline-block; font-size:19px; font-weight:700; padding:8px 22px; margin:12px 0 8px;
        border-radius:99px; text-transform:uppercase; letter-spacing:2px;}
  .pill.on{background:rgba(52,211,153,.13); color:var(--ok); border:2px solid rgba(52,211,153,.45);
            box-shadow:0 0 18px rgba(52,211,153,.12);}
  .pill.off{background:rgba(248,113,113,.10); color:var(--bad); border:2px solid rgba(248,113,113,.4);}
  .pill.na{background:rgba(251,191,36,.10); color:var(--warn); border:2px solid rgba(251,191,36,.4);}

  .rowline{display:flex; justify-content:space-between; align-items:center; gap:14px;
       font-size:25px; padding:11px 0; border-top:2px solid rgba(255,255,255,.07);}
  .rowline .k{color:var(--dim); display:flex; align-items:center; gap:10px;}
  .rowline .v{font-variant-numeric:tabular-nums; text-align:right; font-weight:600;}
  .rowline .v .ok{color:var(--ok);} .rowline .v .bad{color:var(--bad);} .rowline .v .dim{color:var(--dim); font-weight:400;}

  .meter{height:10px; border-radius:99px; background:rgba(255,255,255,.09); margin-top:10px; overflow:hidden;}
  .meter > i{display:block; height:100%; border-radius:99px;
    background:linear-gradient(90deg,var(--acc1),var(--acc2)); box-shadow:0 0 12px rgba(110,231,255,.5);
    transition:width .8s cubic-bezier(.2,.8,.2,1);}
  .meter.warn > i{background:linear-gradient(90deg,var(--warn),#f97316);}
  .meter.bad > i{background:linear-gradient(90deg,var(--bad),#ef4444);}

  .bigstat{display:flex; align-items:baseline; gap:12px; margin:10px 0 4px;}
  .bigstat .n{font-size:56px; font-weight:800; font-variant-numeric:tabular-nums; line-height:1;
    background:linear-gradient(180deg,#fff,#9db4d0); -webkit-background-clip:text; background-clip:text; color:transparent;}
  .bigstat .u{font-size:24px; color:var(--dim);}

  .upl-dots{display:inline-flex; gap:8px; align-items:center;}
  .upl-dots i{width:16px; height:16px; border-radius:50%; background:rgba(255,255,255,.12);}
  .upl-dots i.lit{background:var(--ok); box-shadow:0 0 12px var(--ok); animation:pulse 2.6s ease-in-out infinite;}

  .sess{font-size:23px; color:var(--dim); padding:9px 0 9px 4px; border-left:3px solid rgba(110,231,255,.35);
        margin:7px 0 7px 3px; padding-left:16px; line-height:1.4;}
  .sess b{color:var(--txt);}
  .sess .play{color:var(--acc1);}
  .sesslbl{font-size:20px; text-transform:uppercase; letter-spacing:2.5px; color:var(--faint); margin:16px 0 4px;}
  .stub{font-size:21px; color:var(--warn); margin-top:14px; padding:14px 16px; border-radius:14px; line-height:1.45;
        background:rgba(251,191,36,.07); border:2px dashed rgba(251,191,36,.35);}
  .adbline{font-size:21px; color:var(--dim); margin-top:12px; line-height:1.55;
           padding:14px 16px; border-radius:14px; background:rgba(255,255,255,.03);
           border:2px solid rgba(255,255,255,.07);}
  .adbline b{color:var(--txt);}
  .cal-today{display:inline-block; font-size:18px; font-weight:800; letter-spacing:1.5px; color:#0a0e14;
    background:linear-gradient(90deg,#fcd34d,#fbbf24); border-radius:10px; padding:4px 14px; margin-left:12px;
    animation:pulse 2.4s ease-in-out infinite;}

  /* quick action buttons */
  .qbtn{display:flex; align-items:center; gap:16px; flex:0 0 460px; padding:24px 22px;
    font-size:27px; font-weight:700; color:var(--txt); text-align:left;
    background:linear-gradient(160deg, rgba(255,255,255,.07), rgba(255,255,255,.02));
    border:3px solid rgba(255,255,255,.12); border-radius:20px; outline:none;
    transition:transform .15s ease, border-color .2s ease, box-shadow .2s ease;}
  .qbtn:disabled{opacity:.45;}
  .qbtn .qi{font-size:36px;}
  .qbtn small{display:block; font-size:20px; font-weight:400; color:var(--dim); margin-top:4px;}
  #qmsg{font-size:22px; color:var(--dim); min-height:30px; margin-top:8px; text-align:center;}

  /* detail overlay */
  #overlay{position:fixed; inset:0; z-index:50; display:none; align-items:center; justify-content:center;
    background:rgba(3,5,10,.82); backdrop-filter:blur(8px);}
  #overlay.open{display:flex;}
  #ov-card{width:min(1100px, 86vw); max-height:86vh; overflow-y:auto;
    background:linear-gradient(165deg, rgba(30,38,55,.98), rgba(12,17,28,.98));
    border:3px solid rgba(110,231,255,.4); border-radius:28px; padding:44px 48px;
    box-shadow:0 30px 90px rgba(0,0,0,.7), 0 0 60px rgba(110,231,255,.15);}
  #ov-card h2{font-size:46px; margin:0 0 6px;}
  #ov-card .hint{font-size:22px; color:var(--faint); margin-top:26px; text-align:center;}
  #ov-card .rowline{font-size:30px; padding:14px 0;}
  #ov-card .sess{font-size:28px;}
  #ov-card .bigstat .n{font-size:76px;}
  #ov-card .bigstat .u{font-size:30px;}

  #hint{position:fixed; bottom:14px; left:0; right:0; text-align:center; z-index:5;
        font-size:20px; color:var(--faint); letter-spacing:1px;}
  #hint b{color:var(--dim);}
  footer{text-align:center; font-size:19px; color:var(--faint); padding:8px 0 0; letter-spacing:.4px;}
  footer .live-tag{color:var(--ok);}
  .err-card{text-align:center; padding:40px 26px;}
  .err-card .big{font-size:64px; margin-bottom:12px;}
  a.ext{color:var(--acc1); text-decoration:none; font-weight:600;}

  /* ---------- Phase 1: Notification Center ---------- */
  #notif-stack{position:fixed; top:18px; left:50%; transform:translateX(-50%); z-index:60;
    display:flex; flex-direction:column; gap:12px; width:min(1100px, 80vw); pointer-events:none;}
  .notif{pointer-events:auto; display:flex; align-items:center; gap:18px;
    background:linear-gradient(165deg, rgba(30,38,55,.97), rgba(12,17,28,.97));
    border:3px solid rgba(110,231,255,.4); border-radius:20px; padding:20px 26px;
    box-shadow:0 18px 50px rgba(0,0,0,.6), 0 0 30px rgba(110,231,255,.12);
    animation:notifIn .35s cubic-bezier(.2,.9,.3,1.2); font-size:26px;}
  .notif.warn{border-color:rgba(251,191,36,.55); box-shadow:0 18px 50px rgba(0,0,0,.6), 0 0 30px rgba(251,191,36,.15);}
  .notif.critical{border-color:rgba(248,113,113,.6); box-shadow:0 18px 50px rgba(0,0,0,.6), 0 0 30px rgba(248,113,113,.2);
    animation:notifIn .35s cubic-bezier(.2,.9,.3,1.2), notifPulse 2s ease-in-out 1s infinite;}
  .notif .ni{font-size:40px; flex:none;}
  .notif .nt{font-weight:800; font-size:28px;}
  .notif .nm{color:var(--dim); font-size:23px; margin-top:4px;}
  .notif .nx{margin-left:auto; font-size:22px; color:var(--faint); flex:none; padding:8px 14px;
    border:2px solid rgba(255,255,255,.15); border-radius:12px;}
  @keyframes notifIn{from{transform:translateY(-40px) scale(.95); opacity:0;}to{transform:none; opacity:1;}}
  @keyframes notifPulse{0%,100%{box-shadow:0 18px 50px rgba(0,0,0,.6), 0 0 30px rgba(248,113,113,.2);}
    50%{box-shadow:0 18px 50px rgba(0,0,0,.6), 0 0 50px rgba(248,113,113,.4);}}
  .notif.out{transition:opacity .3s, transform .3s; opacity:0; transform:translateY(-20px);}

  /* ---------- Phase 1: Kavi Briefing hero card ---------- */
  .briefing-hero{flex:0 0 940px;
    background:linear-gradient(150deg, rgba(110,231,255,.10), rgba(167,139,250,.10) 50%, rgba(244,114,182,.08));
    border:3px solid rgba(110,231,255,.35); border-radius:26px; padding:30px 34px;
    box-shadow:0 14px 44px rgba(0,0,0,.45), 0 0 40px rgba(110,231,255,.10);}
  .briefing-hero h2{margin:0 0 4px; font-size:40px; font-weight:800;
    background:linear-gradient(92deg,#fff 10%,var(--acc1) 60%,var(--acc2)); -webkit-background-clip:text; background-clip:text; color:transparent;}
  .briefing-hero .bgreet{font-size:24px; color:var(--dim); margin-bottom:14px;}
  .briefing-hero ul{margin:10px 0; padding:0; list-style:none;}
  .briefing-hero li{font-size:27px; padding:10px 0; border-top:2px solid rgba(255,255,255,.07); line-height:1.4;}
  .briefing-hero .onething{margin-top:16px; padding:18px 20px; border-radius:16px; font-size:28px; font-weight:600;
    background:linear-gradient(90deg, rgba(251,191,36,.12), rgba(251,191,36,.05));
    border:2px solid rgba(251,191,36,.35);}
  .briefing-hero .onething b{color:var(--warn);}

  /* ---------- Phase 1: Hearing countdown card ---------- */
  .hearing-card{flex:0 0 460px;}
  .hearing-days{display:flex; align-items:baseline; gap:14px; margin:12px 0 6px;}
  .hearing-days .n{font-size:84px; font-weight:800; font-variant-numeric:tabular-nums; line-height:1;
    background:linear-gradient(180deg,#fff,#9db4d0); -webkit-background-clip:text; background-clip:text; color:transparent;}
  .hearing-days .u{font-size:28px; color:var(--dim);}
  .check-item{display:flex; align-items:center; gap:12px; font-size:24px; padding:9px 0;
    border-top:2px solid rgba(255,255,255,.06);}
  .check-item .cb{width:30px; height:30px; border-radius:9px; display:grid; place-items:center; flex:none;
    font-size:20px; font-weight:800;}
  .check-item.done .cb{background:rgba(52,211,153,.2); color:var(--ok); border:2px solid rgba(52,211,153,.5);}
  .check-item.todo .cb{background:rgba(255,255,255,.06); color:var(--faint); border:2px solid rgba(255,255,255,.18);}
  .check-item.done{color:var(--dim); text-decoration:line-through; text-decoration-color:rgba(52,211,153,.5);}
  .check-bar{height:12px; border-radius:99px; background:rgba(255,255,255,.09); margin:12px 0 4px; overflow:hidden;}
  .check-bar > i{display:block; height:100%; border-radius:99px;
    background:linear-gradient(90deg,var(--acc1),var(--acc2)); transition:width .8s ease;}

  /* ---------- Phase 1: Photo Frame Mode ---------- */
  #photoframe{position:fixed; inset:0; z-index:70; display:none; background:#000;}
  #photoframe.open{display:block;}
  #pf-img{position:absolute; inset:0; width:100%; height:100%; object-fit:contain;
    transition:opacity 1.2s ease;}
  #pf-cap{position:absolute; bottom:0; left:0; right:0; padding:36px 60px 30px;
    background:linear-gradient(transparent, rgba(0,0,0,.75));
    display:flex; justify-content:space-between; align-items:flex-end;}
  #pf-cap .t{font-size:38px; font-weight:700;}
  #pf-cap .l{font-size:26px; color:var(--dim);}
  #pf-cap .c{font-size:22px; color:var(--faint);}
  #pf-hint{position:absolute; top:24px; right:36px; font-size:22px; color:rgba(255,255,255,.5);}

  /* ---------- Phase 1: Morning section label ---------- */
  .seclabel.morning span{color:var(--acc1);}
  .seclabel.morning::after{background:linear-gradient(90deg, rgba(110,231,255,.35), transparent);}
</style>
</head>
<body>
<div class="orb o1"></div><div class="orb o2"></div><div class="orb o3"></div>

<div class="wrap">
<header>
  <div class="brand">
    <div class="logo" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round">
        <circle cx="12" cy="12" r="3.2" fill="rgba(255,255,255,.9)" stroke="none"/>
        <ellipse cx="12" cy="12" rx="10" ry="4.2" transform="rotate(-24 12 12)"/>
        <ellipse cx="12" cy="12" rx="10" ry="4.2" transform="rotate(38 12 12)" opacity=".55"/>
        <circle cx="19.5" cy="7.5" r="1.3" fill="#fff" stroke="none"/>
      </svg>
    </div>
    <div>
      <h1>MISSION CONTROL</h1>
      <p class="tag">Seth&rsquo;s fleet &middot; TV edition</p>
    </div>
  </div>
  <div class="hdr-right">
    <div id="clock">--:--:--</div>
    <div id="updated">connecting&hellip;</div>
  </div>
</header>

<main id="rows"></main>

<footer><span id="src">&hellip;</span> &middot; collector <span id="collector">&hellip;</span></footer>
</div>

<div id="overlay"><div id="ov-card"></div></div>
<div id="notif-stack" aria-live="polite"></div>
<div id="photoframe">
  <img id="pf-img" alt="Photo" />
  <div id="pf-cap"><div><div class="t" id="pf-title"></div><div class="l" id="pf-loc"></div></div><div class="c" id="pf-count"></div></div>
  <div id="pf-hint"><b>&#8592;&#8594;</b> prev/next &nbsp;&middot;&nbsp; <b>Back</b> exit</div>
</div>
<div id="hint"><b>&#8592;&#8593;&#8595;&#8594;</b> move &nbsp;&middot;&nbsp; <b>OK</b> details &nbsp;&middot;&nbsp; <b>P</b> photos &nbsp;&middot;&nbsp; <b>Back</b> close</div>

<script>
const ICONS = {
  server: `<svg viewBox="0 0 48 48"><defs><linearGradient id="svrCh" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#475569"/><stop offset="1" stop-color="#0b1220"/></linearGradient><linearGradient id="svrGl" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#22d3ee"/><stop offset="1" stop-color="#3b82f6"/></linearGradient></defs><rect x="5" y="7" width="38" height="34" rx="5" fill="url(#svrCh)"/><rect x="8" y="9" width="32" height="2.2" rx="1.1" fill="#fff" opacity=".09"/><rect x="9" y="12.5" width="30" height="7" rx="2.5" fill="#070c16"/><rect x="9" y="22" width="30" height="7" rx="2.5" fill="#070c16"/><rect x="9" y="31.5" width="30" height="7" rx="2.5" fill="#070c16"/><circle cx="13.5" cy="16" r="3" fill="#34d399" opacity=".28"/><circle cx="13.5" cy="16" r="1.7" fill="#34d399"/><circle cx="13.5" cy="25.5" r="3" fill="#22d3ee" opacity=".28"/><circle cx="13.5" cy="25.5" r="1.7" fill="#22d3ee"/><circle cx="13.5" cy="35" r="3" fill="#fbbf24" opacity=".28"/><circle cx="13.5" cy="35" r="1.7" fill="#fbbf24"/><rect x="19" y="14.9" width="16" height="2.2" rx="1.1" fill="url(#svrGl)"/><rect x="19" y="24.4" width="11" height="2.2" rx="1.1" fill="#64748b" opacity=".75"/><rect x="19" y="33.9" width="13.5" height="2.2" rx="1.1" fill="#64748b" opacity=".75"/><rect x="5" y="7" width="38" height="34" rx="5" fill="none" stroke="#7d8aa5" stroke-width="1.4" opacity=".55"/></svg>`,
