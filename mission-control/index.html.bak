  cloud: `<svg viewBox="0 0 48 48"><defs><linearGradient id="clB" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#a5d8ff"/><stop offset="1" stop-color="#2f9df0"/></linearGradient><linearGradient id="clF" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#bfe4ff"/></linearGradient></defs><path d="M33 12.5a9.5 9.5 0 0 0-18.4 2.8A8.6 8.6 0 0 0 16 32.5h17a8 8 0 0 0 0-16z" fill="url(#clB)" opacity=".6" transform="translate(2.5,3)"/><path d="M35.5 15a10.5 10.5 0 0 0-20.3 3.1A9.5 9.5 0 0 0 17 36.5h18.5a8.9 8.9 0 0 0 0-17.8z" fill="url(#clF)"/><ellipse cx="22" cy="24" rx="8" ry="4.4" fill="#fff" opacity=".55"/><path d="M24 27v7M21 31.5l3 3 3-3" stroke="#2f9df0" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  magnet: `<svg viewBox="0 0 48 48"><defs><linearGradient id="mgR" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fb7a7a"/><stop offset="1" stop-color="#b91c1c"/></linearGradient><linearGradient id="mgS" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#8fa0b8"/></linearGradient></defs><path d="M10 5h10.5v15a3.75 3.75 0 0 0 7.5 0V5H38.5v15a14.25 14.25 0 0 1-28.5 0z" fill="url(#mgR)"/><path d="M10 5h10.5v15a3.75 3.75 0 0 0 7.5 0V5H38.5v15a14.25 14.25 0 0 1-28.5 0z" fill="none" stroke="#7f1d1d" stroke-width="1.4" opacity=".6"/><rect x="10" y="5" width="10.5" height="8.5" fill="url(#mgS)"/><rect x="28" y="5" width="10.5" height="8.5" fill="url(#mgS)"/><rect x="10" y="5" width="10.5" height="2.6" fill="#fff" opacity=".55"/><rect x="28" y="5" width="10.5" height="2.6" fill="#fff" opacity=".55"/><path d="M24 34v6M21.5 37h5" stroke="#fbbf24" stroke-width="2.2" stroke-linecap="round"/><circle cx="15" cy="40" r="1.6" fill="#fde68a"/><circle cx="33" cy="40" r="1.6" fill="#fde68a"/></svg>`,
  shield: `<svg viewBox="0 0 48 48"><defs><linearGradient id="shB" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3ddc97"/><stop offset="1" stop-color="#0e7490"/></linearGradient><linearGradient id="shI" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#d3fbe9"/><stop offset="1" stop-color="#5eead4"/></linearGradient></defs><path d="M24 3l16.5 6.7V24c0 10.2-7 16.8-16.5 21.5C14.5 40.8 7.5 34.2 7.5 24V9.7z" fill="url(#shB)"/><path d="M24 8.2l11.8 4.8v10.3c0 7.4-5 12.2-11.8 15.5-6.8-3.3-11.8-8.1-11.8-15.5V13z" fill="url(#shI)" opacity=".92"/><path d="M17.5 23.8l4.6 4.6 8.4-8.8" stroke="#065f46" stroke-width="4.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/><path d="M13.5 6.8l5 2" stroke="#fff" stroke-width="2.6" opacity=".55" stroke-linecap="round"/></svg>`,
  calendar: `<svg viewBox="0 0 48 48"><defs><linearGradient id="calH" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#fb7185"/><stop offset="1" stop-color="#e11d48"/></linearGradient><linearGradient id="calB" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#dbe4f0"/></linearGradient></defs><rect x="7" y="9" width="34" height="32" rx="5.5" fill="url(#calB)"/><path d="M7 14.5A5.5 5.5 0 0 1 12.5 9h23A5.5 5.5 0 0 1 41 14.5V20H7z" fill="url(#calH)"/><rect x="13" y="5" width="4.4" height="10" rx="2.2" fill="#94a3b8"/><rect x="30.6" y="5" width="4.4" height="10" rx="2.2" fill="#94a3b8"/><rect x="7" y="9" width="34" height="32" rx="5.5" fill="none" stroke="#b6c2d6" stroke-width="1.3"/><circle cx="15.5" cy="27.5" r="2.4" fill="#38bdf8"/><circle cx="24" cy="27.5" r="2.4" fill="#a78bfa"/><circle cx="32.5" cy="27.5" r="2.4" fill="#34d399"/><circle cx="15.5" cy="34.5" r="2.4" fill="#fbbf24"/><circle cx="24" cy="34.5" r="3" fill="#e11d48"/><circle cx="32.5" cy="34.5" r="2.4" fill="#94a3b8"/></svg>`,
